{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "type": "object",
  "properties": {
    "envelope": { "$ref": "#/$defs/Envelope" },
    "auth": { "$ref": "#/$defs/AuthPayload" },
    "authOk": { "$ref": "#/$defs/AuthOkPayload" },
    "pairStart": { "$ref": "#/$defs/PairStartPayload" },
    "pairChallenge": { "$ref": "#/$defs/PairChallengePayload" },
    "pairConfirm": { "$ref": "#/$defs/PairConfirmPayload" },
    "pairResult": { "$ref": "#/$defs/PairResultPayload" },
    "chatSend": { "$ref": "#/$defs/ChatSendPayload" },
    "chatHistory": { "$ref": "#/$defs/ChatHistoryPayload" },
    "chatHistoryResult": { "$ref": "#/$defs/ChatHistoryResultPayload" },
    "chatDelta": { "$ref": "#/$defs/ChatDeltaPayload" },
    "chatDone": { "$ref": "#/$defs/ChatDonePayload" },
    "visionStart": { "$ref": "#/$defs/VisionStartPayload" },
    "visionProgress": { "$ref": "#/$defs/VisionProgressPayload" },
    "visionDone": { "$ref": "#/$defs/VisionDonePayload" },
    "visionCancel": { "$ref": "#/$defs/VisionCancelPayload" },
    "error": { "$ref": "#/$defs/ErrorPayload" },

    "objectRecord": { "$ref": "#/$defs/ObjectRecord" },
    "objectDraft": { "$ref": "#/$defs/ObjectDraft" },
    "objectOp": { "$ref": "#/$defs/ObjectOp" },
    "artifactInfo": { "$ref": "#/$defs/ArtifactInfo" },
    "syncPull": { "$ref": "#/$defs/SyncPullPayload" },
    "syncChanges": { "$ref": "#/$defs/SyncChangesPayload" },
    "syncPush": { "$ref": "#/$defs/SyncPushPayload" },
    "syncPushResult": { "$ref": "#/$defs/SyncPushResultPayload" },
    "lockRequest": { "$ref": "#/$defs/LockRequestPayload" },
    "lockState": { "$ref": "#/$defs/LockStatePayload" },
    "lockChanged": { "$ref": "#/$defs/LockChangedPayload" },
    "toolConfirm": { "$ref": "#/$defs/ToolConfirmPayload" },
    "toolDecision": { "$ref": "#/$defs/ToolDecisionPayload" }
  },
  "$defs": {
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type", "ts", "nonce", "payload"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "id": { "type": "string", "format": "uuid" },
        "type": { "type": "string", "enum": ["auth", "auth.ok", "pair.start", "pair.challenge", "pair.confirm", "pair.result", "chat.send", "chat.history", "chat.history.result", "chat.delta", "chat.done", "vision.start", "vision.progress", "vision.done", "vision.cancel", "sync.pull", "sync.changes", "sync.push", "sync.push.result", "lock.acquire", "lock.release", "lock.heartbeat", "lock.state", "lock.changed", "tool.confirm", "tool.decision", "ping", "pong", "error"] },
        "ts": { "type": "integer", "minimum": 0 },
        "nonce": { "type": "string", "minLength": 8, "maxLength": 128 },
        "payload": true
      }
    },
    "AuthPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "token"],
      "properties": {
        "device_id": { "type": "string", "format": "uuid" },
        "token": { "type": "string", "minLength": 32 }
      }
    },
    "AuthOkPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "device_name"],
      "properties": {
        "device_id": { "type": "string" },
        "device_name": { "type": "string" }
      }
    },
    "PairStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "device_id", "device_name", "public_key"],
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "device_id": { "type": "string", "format": "uuid" },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "public_key": { "type": "string", "minLength": 32 }
      }
    },
    "PairChallengePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "server_public_key", "short_word"],
      "properties": {
        "pair_id": { "type": "string", "format": "uuid" },
        "server_public_key": { "type": "string" },
        "short_word": { "type": "string" }
      }
    },
    "PairConfirmPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id"],
      "properties": {
        "pair_id": { "type": "string", "format": "uuid" }
      }
    },
    "PairResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "token"],
      "properties": {
        "device_id": { "type": "string", "format": "uuid" },
        "token": { "type": "string" }
      }
    },
    "ChatSendPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "session_id": { "type": "string", "default": "default" },
        "content": { "type": "string", "minLength": 1, "maxLength": 32000 }
      }
    },
    "ChatHistoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string", "default": "default" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 }
      }
    },
    "ChatHistoryResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "messages"],
      "properties": {
        "session_id": { "type": "string" },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/Message" } }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "session_id", "role", "content", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string" },
        "created_at": { "type": "integer" }
      }
    },
    "ChatDeltaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "message_id", "delta"],
      "properties": {
        "session_id": { "type": "string" },
        "message_id": { "type": "string" },
        "delta": { "type": "string" }
      }
    },
    "ChatDonePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "message_id", "content"],
      "properties": {
        "session_id": { "type": "string" },
        "message_id": { "type": "string" },
        "content": { "type": "string" }
      }
    },
    "VisionStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "goal", "window_title"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 32000 },
        "window_title": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "VisionProgressPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status", "step", "action_count", "message"],
      "properties": {
        "task_id": { "type": "string" },
        "status": { "type": "string", "enum": ["started", "observed", "actions", "finished", "cancelled", "failed"] },
        "step": { "type": "integer", "minimum": 0 },
        "action_count": { "type": "integer", "minimum": 0 },
        "message": { "type": "string" }
      }
    },
    "VisionDonePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "success", "message"],
      "properties": {
        "task_id": { "type": "string" },
        "success": { "type": "boolean" },
        "message": { "type": "string" }
      }
    },
    "VisionCancelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "request_id": { "type": "string" }
      }
    },

    "ObjectType": {
      "title": "ObjectType",
      "type": "string",
      "enum": ["note", "memo", "todo", "artifact"]
    },

    "ObjectOpKind": {
      "title": "ObjectOpKind",
      "type": "string",
      "enum": ["upsert", "delete"]
    },

    "ArtifactInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blob_id", "name", "mime", "size", "sha256"],
      "properties": {
        "blob_id": { "type": "string" },
        "name": { "type": "string" },
        "mime": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "thumb_blob_id": { "type": "string" }
      }
    },

    "ObjectRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content", "seq", "rev", "created_at", "updated_at", "deleted_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "$ref": "#/$defs/ObjectType" },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 200000 },
        "seq": { "type": "integer", "minimum": 0 },
        "rev": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "integer" },
        "updated_at": { "type": "integer" },
        "deleted_at": { "type": "integer", "description": "0 表示未删除；非 0 为墓碑，客户端据此移除" },
        "artifact": { "$ref": "#/$defs/ArtifactInfo" }
      }
    },

    "ObjectDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "content", "base_rev"],
      "properties": {
        "id": { "type": "string", "description": "空字符串表示新建，由服务端分配" },
        "type": { "$ref": "#/$defs/ObjectType" },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 200000 },
        "base_rev": { "type": "integer", "minimum": 0, "description": "客户端编辑时持有的版本号；0 表示新建" }
      }
    },

    "ObjectOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "draft"],
      "properties": {
        "op": { "$ref": "#/$defs/ObjectOpKind" },
        "draft": { "$ref": "#/$defs/ObjectDraft" }
      }
    },

    "SyncPullPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since_seq"],
      "properties": {
        "since_seq": { "type": "integer", "minimum": 0, "default": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 500 }
      }
    },

    "SyncChangesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "objects"],
      "properties": {
        "seq": { "type": "integer", "description": "本次结果对应的最新 seq，客户端应存下来作为下次 since_seq" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/ObjectRecord" } }
      }
    },

    "SyncPushPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ops"],
      "properties": {
        "ops": { "type": "array", "items": { "$ref": "#/$defs/ObjectOp" } }
      }
    },

    "SyncPushResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "accepted", "conflicts"],
      "properties": {
        "seq": { "type": "integer" },
        "accepted": { "type": "integer" },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/ObjectRecord" },
          "description": "提交时 base_rev 已过期的对象，回传服务端当前版本供客户端另存副本"
        }
      }
    },

    "LockRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id"],
      "properties": {
        "object_id": { "type": "string" }
      }
    },

    "LockStatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "granted", "holder_device_name", "expires_in_ms"],
      "properties": {
        "object_id": { "type": "string" },
        "granted": { "type": "boolean" },
        "holder_device_name": { "type": "string", "description": "未持有时为空字符串" },
        "expires_in_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "LockChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "holder_device_name", "expires_in_ms"],
      "properties": {
        "object_id": { "type": "string" },
        "holder_device_name": { "type": "string", "description": "空字符串表示锁已释放" },
        "expires_in_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "ToolConfirmPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "tool", "summary", "risk", "expires_in_ms"],
      "properties": {
        "call_id": { "type": "string" },
        "tool": { "type": "string" },
        "summary": { "type": "string", "description": "给用户看的一句话说明，描述这次操作到底做什么" },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "blocked"] },
        "expires_in_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "ToolDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "approve"],
      "properties": {
        "call_id": { "type": "string" },
        "approve": { "type": "boolean" }
      }
    }
  }
}
